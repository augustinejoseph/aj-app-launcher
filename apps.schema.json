{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AJ public registry v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "apps"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "apps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "description",
          "repository",
          "url",
          "icon",
          "status",
          "enabled"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "repository": {
            "type": "string",
            "pattern": "^aj-[a-z0-9-]+$"
          },
          "url": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "format": "uri",
                "pattern": "^https://"
              }
            ]
          },
          "icon": {
            "enum": [
              "heart-pulse",
              "book-open"
            ]
          },
          "status": {
            "enum": [
              "available",
              "development",
              "planned",
              "unverified",
              "retired"
            ]
          },
          "enabled": {
            "type": "boolean"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "available"
                }
              }
            },
            "then": {
              "properties": {
                "url": {
                  "type": "string"
                }
              }
            }
          }
        ]
      }
    }
  }
}
